#include <winres.h>

#include "Version.h"

1 ICON "opal.ico"
1 RT_MANIFEST "app.manifest"

101 WAVE "sounds/shutter-modern.wav"
102 WAVE "sounds/shutter-vintage.wav"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OPAL_VERSION_MAJOR,OPAL_VERSION_MINOR,OPAL_VERSION_PATCH,0
 PRODUCTVERSION OPAL_VERSION_MAJOR,OPAL_VERSION_MINOR,OPAL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Opal"
            VALUE "FileDescription", "Opal - macOS-style screenshots"
            VALUE "FileVersion", OPAL_VERSION_TEXT
            VALUE "InternalName", "Opal"
            VALUE "OriginalFilename", "Opal.exe"
            VALUE "ProductName", "Opal"
            VALUE "ProductVersion", OPAL_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
